# ============================================================
# Caddyfile de PRODUCCION — entrada HTTPS unificada
# ============================================================
# NO APLICADO. Preparado y validado en el laboratorio.
#
# Topologia de produccion (docker-compose.yml):
#
#   LAN ──── HTTPS :443 ──┐
#                          ├──> caddy ──> app:4000  (Express + frontend compilado)
#   cloudflared ───────────┘
#
# A diferencia del laboratorio, en produccion Express y el frontend
# compilado viven en el MISMO contenedor (`app`), asi que todo el
# trafico va al mismo upstream. No hay Vite ni HMR en produccion.
#
# Por que Caddy y no solo el backend:
#   - es el unico que cierra TLS, asi que Express no necesita saber
#     nada de certificados;
#   - es el unico pariente TCP de Express, lo que permite confiar en
#     una IP concreta (TRUST_PROXY) en lugar de confiar en todo;
#   - permite quitar los puertos publicados de la aplicacion.

tickets.lan {
	# CA local de Caddy. Los dispositivos de la LAN deben confiar en
	# esa CA raiz (README.md seccion 3). Con un dominio publico real,
	# sustituir por: tls { issuer acme { email admin@ejemplo.com } }
	tls internal

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Sin `trusted_proxies`: Caddy IGNORA las cabeceras X-Forwarded-*
	# que envien los clientes y escribe las suyas. Medido en el
	# laboratorio: un cliente que manda X-Forwarded-Proto: http no
	# consigue que Express deje de ver HTTPS.
	reverse_proxy app:4000

	log {
		# Solo access log: no se registran cabeceras ni cookies, para
		# que el token de sesion no acabe en disco.
		output stdout
		format console
	}
}
