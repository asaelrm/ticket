# ============================================================================
# Ticket - Backend
# Copie este archivo a `.env` y ajuste los valores según su entorno.
#   cp .env.example .env
# ============================================================================

# Entorno: development | production | test
NODE_ENV=development

# Puerto HTTP donde escucha la API (el frontend en dev usa el proxy /api)
PORT=4000

# Secreto de las sesiones. En DESARROLLO puede dejarlo vacío: la aplicación usa
# un valor de desarrollo (público, y por eso rechazado en producción).
# En PRODUCCIÓN es obligatorio, de 32 caracteres o más, y no puede ser un valor
# de ejemplo: si falta o es débil, el proceso NO arranca. Genere uno con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# URL pública usada para construir enlaces absolutos en correos (sin slash final).
# Obligatoria en producción: sin ella el proceso no arranca, porque el enlace de
# recuperación se construiría con un origen equivocado.
# PUBLIC_URL=https://tickets.tuempresa.com

# ---------------------------------------------------------------------------
# Cuentas iniciales
# ---------------------------------------------------------------------------
# El seed NO inventa ninguna contraseña: sin estas variables no se crea ninguna
# cuenta. El procedimiento para el administrador es:
#   1. defina SEED_ADMIN_PASSWORD con 12+ caracteres;
#   2. arranque una vez (crea el administrador);
#   3. entre y quítela del entorno.
# Si la cuenta YA existe, la variable se ignora y el arranque avisa: la
# contraseña que haya se respeta. Para restablecerla de verdad, defina además
# SEED_ADMIN_FORCE_PASSWORD=true una sola vez, compruebe el acceso y quite las
# dos variables.
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FORCE_PASSWORD=false
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@empresa.com

# Cuentas de demostración (empleado y técnico). SOLO para desarrollo local y
# nunca en producción, donde la aplicación las rechaza aunque se activen.
# Basta con poner SEED_DEMO_ACCOUNTS=false: que NODE_ENV no sea "production" ya
# no es motivo suficiente. Sin SEED_DEMO_PASSWORD / SEED_TECH_PASSWORD las
# cuentas se crean con una contraseña aleatoria inusable y el arranque avisa.
# SEED_DEMO_ACCOUNTS=false
# SEED_DEMO_PASSWORD=
# SEED_TECH_PASSWORD=

# Directorio de usuarios y departamentos (backend/directory.json).
# Guarda el PERFIL de las cuentas, nunca contraseñas, y no está versionado.
# DIRECTORY_SYNC=true
# DIRECTORY_SNAPSHOT_FILE=directory.json

# Cookie de sesión solo HTTPS. Actívelo en producción.
# IMPORTANTE: la misma instancia sirve hoy HTTPS por Cloudflare y HTTP desde la
# red local. Con COOKIE_SECURE=true el navegador NO enviará la cookie de sesión
# por http://, así que el acceso por la LAN deixará de permitir iniciar sesión.
# Ponga primero HTTPS también en la red local (ver README, "HTTPS en la LAN").
# Sin valor, la aplicación avisa al arrancar de que la cookie puede viajar sin
# cifrar; no es un error, porque hay despliegues que siguen en HTTP.
# COOKIE_SECURE=false

# Proxy de confianza: IP o CIDR del proxy o túnel que termina TLS delante de la
# aplicación (por ejemplo cloudflared).VACÍO o false = no se confía en ninguna
# cabecera X-Forwarded-*, estado actual y más seguro por defecto.
# Acepte varios separados por comas: 10.0.0.5, 172.18.0.0/16
# NO ponga true/yes/on: con esa opción cualquier cliente puede declarar
# X-Forwarded-Proto: https y falsear la visión de cifrado de la aplicación.
TRUST_PROXY=

# Hosts públicos que deben recibir HSTS, separados por comas. Solo tiene efecto
# si la petición llega por HTTPS verificado. El nombre interno de la LAN no debe
# listarse aquí, o el navegador anclaría ese nombre a HTTPS.
PUBLIC_HOSTS=

# Origen permitido para CORS (del frontend en desarrollo con Vite).
CORS_ORIGIN=http://localhost:5173

# Base de datos SQLite. Déjelo vacío para usar $DATA_DIR/tickets.db
DB_FILE=

# Motor de ejecución. Vacío/sqlite = SQLite (por defecto). DB_CLIENT=mssql solo
# describe el motor pedido (lo usan los scripts de migración); el proceso NO
# cambia a SQL Server hasta que se active explícitamente con MSSQL_RUNTIME=true.
# Mientras la migración por fases no convierta todos los módulos y el esquema
# MSSQL esté aplicado, deje MSSQL_RUNTIME sin definir: forzarlo sin ese esquema
# rompe el inicio de sesión (las sesiones irían a una base sin tabla `sessions`).
# DB_CLIENT=
# MSSQL_RUNTIME=false

# Conexión a SQL Server (solo migración; ver scripts/migration/*)
# DB_SERVER=host\INSTANCIA
# DB_PORT=1433
# DB_DATABASE=<base destino>
# DB_USER=<usuario de migración>
# DB_PASSWORD=<clave>
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
# DB_INSTANCE=SIFHADEV

# Directorio de datos (BD y sesiones). Relativo a backend/.
DATA_DIR=data

# Directorio de archivos adjuntos. Relativo a backend/.
UPLOAD_DIR=uploads

# Límites de subida
MAX_UPLOAD_SIZE_MB=5
MAX_FILES_PER_TICKET=5

# ============================================================================
# Notificaciones por correo (SMTP)
# Con MAIL_ENABLED=false los correos NO se envían de verdad: se registran en
# consola y en la tabla email_logs (modo desarrollo/pruebas).
# ============================================================================
# MAIL_ENABLED=true
# MAIL_TRANSPORT=auto          # auto | smtp (auto usa SMTP si hay host, dev si no)
# SMTP_HOST=smtp.tuempresa.com
# SMTP_PORT=587                # 587 (STARTTLS) o 465 (SSL)
# SMTP_SECURE=false            # true si SMTP_PORT=465 con SSL directo
# SMTP_USER=notificaciones@tuempresa.com
# SMTP_PASS=cambie-esta-contrasena
# SMTP_FROM=notificaciones@tuempresa.com
# SMTP_FROM_NAME=Ticket

# Directorio del frontend compilado (para producción). Relativo a la raíz del repo.
# PUBLIC_DIR=frontend/dist