{
  "name": "ticket-flow-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "test": "node --test --env-file-if-exists=.env \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.1",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}
