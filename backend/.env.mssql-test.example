# Configuración para pruebas MSSQL reales de integración
# Copie este archivo a .env.mssql-test y ajuste los valores
# NO commitear credenciales reales

# Servidor SQL Server (requerido)
MSSQL_TEST_SERVER=100.100.4.60

# Puerto (opcional, default 1433)
MSSQL_TEST_PORT=1433

# Nombre de la base de pruebas (OBLIGATORIO: debe ser exactamente este valor)
MSSQL_TEST_DATABASE=SIFHA_Tickets_M5_Integration_Test

# Usuario y contraseña (requeridos)
MSSQL_TEST_USER=sifha_migration_dev
MSSQL_TEST_PASSWORD=su_password_seguro_aqui

# Instancia (opcional, para SQL Server named instances)
MSSQL_TEST_INSTANCE=SIFHADEV

# TLS/SSL
MSSQL_TEST_ENCRYPT=true
MSSQL_TEST_TRUST_SERVER_CERTIFICATE=true

# Credenciales de usuarios de prueba (deben existir en la base)
# Admin por defecto del seed
MSSQL_TEST_ADMIN_USER=admin
MSSQL_TEST_ADMIN_PASS=TestAdmin123!

# Empleado por defecto del seed
MSSQL_TEST_EMPLEADO_USER=empleado
MSSQL_TEST_EMPLEADO_PASS=Empleado1234!

# Técnico por defecto del seed
MSSQL_TEST_TECNICO_USER=tecnico
MSSQL_TEST_TECNICO_PASS=Tecnico1234!

# Configuración de la aplicación (se sobrescribe en setup-mssql.js)
NODE_ENV=test
DB_CLIENT=mssql
MSSQL_RUNTIME=true
JOBS_ENABLED=false
SEED_ADMIN_PASSWORD=TestAdmin123!
SEED_DEMO_ACCOUNTS=true
SEED_DEMO_PASSWORD=Empleado1234!
SEED_TECH_PASSWORD=Tecnico1234!